# Copy to .env.local and fill in what you have. Everything is optional for local demo use.

# Database. Leave empty to use the embedded PGlite database in ./.data (local only).
# For production use a real Postgres, e.g. Supabase or Neon.
DATABASE_URL=

# Admin page password. Without it the admin page is switched off.
ADMIN_PASSWORD=

# Secret for the scheduled forecast endpoint (/api/cron).
CRON_SECRET=

# Hard cap on model spending per calendar month, in USD.
MONTHLY_BUDGET_USD=50

# Model providers. A model whose provider key is missing writes labelled demo forecasts.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
OPENROUTER_API_KEY=
