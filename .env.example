# Copy to .env.local and fill in what you have. Everything is optional for local demo use.

# Database. Leave empty to use the embedded PGlite database in ./.data (local only).
# For production use a real Postgres, e.g. Supabase or Neon.
DATABASE_URL=

# Set to false to start the local database empty instead of with demo content.
SEED_DEMO=

# Admin page password. Without it the admin page is switched off.
ADMIN_PASSWORD=

# Secret for the scheduled forecast endpoint (/api/cron).
CRON_SECRET=

# Hard cap on model spending per calendar month, in USD.
MONTHLY_BUDGET_USD=50

# Model providers. Which variable belongs to which provider is set in sanity.config.ts.
# With DATABASE_URL set, a model whose provider key is missing sits out.
# In local demo mode (no DATABASE_URL) it writes labelled demo forecasts instead.
# Test the connections with: npm run check:models
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
OPENROUTER_API_KEY=
